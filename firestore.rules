rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'happinessaggarwal@gmail.com' ||
          request.auth.token.email.lower() == 'divyanshdhimanteam@gmail.com' ||
          request.auth.token.email.lower() == 'admin@gmail.com'
        ))
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isEmail(email) {
      return signedIn() && request.auth.token.email != null && email != null &&
        request.auth.token.email.lower() == email.lower();
    }

    function isConversationParticipant(conv) {
      return signedIn() && (
        request.auth.uid == conv.studentId ||
        request.auth.uid == conv.tutorId ||
        isEmail(conv.studentEmail) ||
        isEmail(conv.tutorEmail) ||
        (conv.participantIds != null && (
          request.auth.uid in conv.participantIds ||
          (request.auth.token.email != null && request.auth.token.email.lower() in conv.participantIds)
        ))
      );
    }

    function isStudent(conv) {
      return signedIn() && (
        request.auth.uid == conv.studentId ||
        isEmail(conv.studentEmail) ||
        isEmail(conv.student.email)
      );
    }

    function isTutor(conv) {
      return signedIn() && (
        request.auth.uid == conv.tutorId ||
        isEmail(conv.tutorEmail) ||
        isEmail(conv.tutor.email)
      );
    }

    function isUnlockedConversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.unlocked == true;
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{uid} {
      // Users can only view their own profile; Admin can view all
      allow read: if isOwner(uid) || isAdmin();

      // Creation: cannot grant self admin privileges
      allow create: if (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role != 'Admin') && (!('admin' in request.resource.data) || request.resource.data.admin != true)) || isAdmin();

      // Update: users cannot tamper with role, admin status, inflated coins, or fake active membership
      allow update: if isAdmin() || (
        isOwner(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin) &&
        (!('coins' in request.resource.data) || request.resource.data.coins <= resource.data.coins) &&
        (!('membership' in request.resource.data) || request.resource.data.membership.status == resource.data.membership.status)
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. Tutors Directory
    // ==========================================
    match /tutors/{tutorId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // ==========================================
    // 2b. Tutor verification documents (Aadhaar / ID, qualification certificate)
    // ==========================================
    match /tutor_documents/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // 3. Students Directory
    // ==========================================
    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId) || isEmail(resource.data.email);
      allow create, update: if isOwner(studentId) || isEmail(request.resource.data.email) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. Inquiries & Requests
    // ==========================================
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() || isConversationParticipant(resource.data);
      allow create: if isAdmin() || (signedIn() && (request.auth.uid == request.resource.data.studentId || isEmail(request.resource.data.studentEmail)));
      allow update: if isAdmin() || isConversationParticipant(resource.data);
      allow delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdmin() || isConversationParticipant(resource.data);
      allow create: if isAdmin() || signedIn();
      allow update: if isAdmin() || isConversationParticipant(resource.data);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. 1-to-1 Conversations & Messages
    // ==========================================
    match /conversations/{conversationId} {
      // Both participants and admin can read conversation metadata
      allow read: if isAdmin() || isConversationParticipant(resource.data);

      // Student or Admin can initiate conversation
      allow create: if isAdmin() || (signedIn() && (
        request.auth.uid == request.resource.data.studentId ||
        isEmail(request.resource.data.studentEmail) ||
        isEmail(request.resource.data.student.email)
      ));

      // Student can update timestamps/lastMessage. Tutor can update only if unlocked or unlocking.
      allow update: if isAdmin() ||
        isStudent(resource.data) ||
        (isTutor(resource.data) && (resource.data.unlocked == true || request.resource.data.unlocked == true));

      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Teacher can ONLY read messages if conversation has been unlocked!
        allow read: if isAdmin() || (
          signedIn() && (
            isStudent(get(/databases/$(database)/documents/conversations/$(conversationId)).data) ||
            (isTutor(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && isUnlockedConversation(conversationId))
          )
        );

        // Teacher can ONLY send message if conversation has been unlocked!
        allow create: if isAdmin() || (
          signedIn() && (
            isStudent(get(/databases/$(database)/documents/conversations/$(conversationId)).data) ||
            (isTutor(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && isUnlockedConversation(conversationId))
          )
        );

        allow update, delete: if isAdmin();
      }
    }

    // ==========================================
    // 6. Coin Transactions & Audit Log
    // ==========================================
    match /coin_transactions/{txId} {
      allow read: if isAdmin() || (signedIn() && (
        request.auth.uid == resource.data.tutorId ||
        isEmail(resource.data.tutorEmail)
      ));

      allow create: if isAdmin() || (signedIn() && (
        request.auth.uid == request.resource.data.tutorId ||
        isEmail(request.resource.data.tutorEmail)
      ));

      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 7. Active Leads & Relationships
    // ==========================================
    match /leads/{leadId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && (
        request.auth.uid == request.resource.data.studentId ||
        isEmail(request.resource.data.email)
      ));
      allow delete: if isAdmin();
    }

    match /relationships/{relId} {
      allow read: if isAdmin() || (signedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.tutorId ||
        isEmail(resource.data.studentEmail) ||
        isEmail(resource.data.tutorEmail)
      ));
      allow write: if isAdmin() || signedIn();
    }

    // ==========================================
    // 8. Blogs (tutors publish, anyone reads, signed-in users comment)
    // Limit: each tutor can publish at most 2 blogs per calendar month (UTC).
    // The quota counter and the blog are written together in one batch. The blog id must be
    // <uid>_<year>_<month>_<count>, so a second post can never reuse the same count.
    // ==========================================
    function monthTag() {
      return string(request.time.year()) + '_' + string(request.time.month());
    }
    function quotaPath() {
      return /databases/$(database)/documents/blog_quota/$(request.auth.uid + '_' + monthTag());
    }

    match /blog_quota/{qid} {
      allow read: if isAdmin() || (signedIn() && qid.matches(request.auth.uid + '_.*'));
      allow create: if signedIn()
        && qid == request.auth.uid + '_' + monthTag()
        && request.resource.data.keys().hasOnly(['uid', 'count'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && qid == request.auth.uid + '_' + monthTag()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 2;
      allow delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'title', 'category', 'excerpt', 'body', 'read', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 100 && request.resource.data.body.size() <= 20000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 200
        && getAfter(quotaPath()).data.count <= 2
        && getAfter(quotaPath()).data.count == (exists(quotaPath()) ? get(quotaPath()).data.count : 0) + 1
        && blogId == request.auth.uid + '_' + monthTag() + '_' + string(getAfter(quotaPath()).data.count);

      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.role is string && request.resource.data.role.size() <= 30
          && exists(/databases/$(database)/documents/blogs/$(blogId));
        allow update: if false;
        // The commenter, the blog's author and the admin can remove a comment
        allow delete: if isAdmin() || (signedIn() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/blogs/$(blogId)).data.authorUid == request.auth.uid
        ));
      }
    }
  }
}