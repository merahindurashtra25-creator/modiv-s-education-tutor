rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function tutorHasActivePlan(tutorUid) {
      let inUsers = exists(/databases/$(database)/documents/users/$(tutorUid)) &&
        get(/databases/$(database)/documents/users/$(tutorUid)).data.subscription.active == true &&
        (get(/databases/$(database)/documents/users/$(tutorUid)).data.subscription.expiresAt == null ||
         request.time < get(/databases/$(database)/documents/users/$(tutorUid)).data.subscription.expiresAt);
      let inTutors = exists(/databases/$(database)/documents/tutors/$(tutorUid)) &&
        get(/databases/$(database)/documents/tutors/$(tutorUid)).data.subscription.active == true &&
        (get(/databases/$(database)/documents/tutors/$(tutorUid)).data.subscription.expiresAt == null ||
         request.time < get(/databases/$(database)/documents/tutors/$(tutorUid)).data.subscription.expiresAt);
      return inUsers || inTutors;
    }

    // Users Collection
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isOwner(uid) || admin();
      allow delete: if admin();
    }

    // Tutors Directory
    // Public read ONLY for approved tutors; pending/rejected tutors only visible to owner or admin
    match /tutors/{tutorId} {
      allow read: if resource.data.status == 'approved' ||
        (signedIn() && (request.auth.uid == resource.data.uid || request.auth.token.email == resource.data.email)) ||
        admin();
      allow create: if signedIn();
      allow update: if (signedIn() && (request.auth.uid == resource.data.uid || request.auth.token.email == resource.data.email)) || admin();
      allow delete: if admin();
    }

    // Students Directory
    // Student can read own profile; subscribed tutors and admin can read
    match /students/{studentId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.email == resource.data.email ||
        admin() ||
        tutorHasActivePlan(request.auth.uid)
      );
      allow create: if signedIn();
      allow update: if (signedIn() && (request.auth.uid == resource.data.uid || request.auth.token.email == resource.data.email)) || admin();
      allow delete: if admin();
    }

    // Leads & Enquiries
    match /leads/{leadId} {
      allow read: if true;
      allow write: if signedIn() || admin();
    }
    match /enquiries/{enquiryId} {
      allow read: if signedIn();
      allow write: if signedIn() || admin();
    }

    // 1-to-1 Conversations
    match /conversations/{conversationId} {
      allow read: if admin() || (signedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.tutorId ||
        request.auth.token.email in resource.data.participantIds ||
        request.auth.uid in resource.data.participantIds
      ));
      allow create: if signedIn() && (
        request.auth.uid == request.resource.data.studentId ||
        request.auth.uid == request.resource.data.tutorId ||
        request.auth.uid in request.resource.data.participantIds
      ) && request.resource.data.participantIds.size() >= 2;
      allow update: if admin() || (signedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.tutorId ||
        request.auth.token.email in resource.data.participantIds ||
        request.auth.uid in resource.data.participantIds
      ));
      allow delete: if admin();

      // Messages Subcollection
      match /messages/{messageId} {
        // Enforce 96-hour (4-day) auto-expiry cutoff on reads
        // Enforce Tutor subscription requirement: Unsubscribed tutors cannot read message content
        allow read: if (resource.data.expiresAt == null || resource.data.expiresAt > request.time) && (
          admin() ||
          (signedIn() && (
            request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId ||
            request.auth.token.email == get(/databases/$(database)/documents/conversations/$(conversationId)).data.student.email
          )) ||
          (signedIn() && (
            request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.tutorId ||
            request.auth.token.email == get(/databases/$(database)/documents/conversations/$(conversationId)).data.tutor.email
          ) && tutorHasActivePlan(request.auth.uid))
        );

        allow create: if signedIn() && (
          admin() ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId ||
          request.auth.token.email == get(/databases/$(database)/documents/conversations/$(conversationId)).data.student.email ||
          ((request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.tutorId ||
            request.auth.token.email == get(/databases/$(database)/documents/conversations/$(conversationId)).data.tutor.email) &&
           tutorHasActivePlan(request.auth.uid))
        ) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.messageType == 'text';

        allow update: if signedIn() && (
          admin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'processingStatus']);

        allow delete: if admin() || (resource.data.expiresAt != null && resource.data.expiresAt <= request.time);
      }
    }

    // Admin Chat Safety Alerts
    match /adminChatAlerts/{alertId} {
      allow read: if admin();
      allow create: if signedIn();
      allow update, delete: if admin();
    }
  }
}
