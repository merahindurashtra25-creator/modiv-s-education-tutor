# --- Public Client Configuration (Firebase Web Identifiers) ---
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=modivs-education.firebaseapp.com
FIREBASE_PROJECT_ID=modivs-education
FIREBASE_STORAGE_BUCKET=modivs-education.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=821328108086
FIREBASE_APP_ID=1:821328108086:web:852c06bc88fb39d0961697
FIREBASE_MEASUREMENT_ID=G-H4JWBNLBC5

# --- Google Maps Places API Key (Restrict by HTTP Referrer in Cloud Console) ---
GOOGLE_MAPS_API_KEY=AIzaSyDi4be0HNq7v1Ayf3Wlikdkc2iGpf22VBo

# --- Firebase App Check (reCAPTCHA v3 / Enterprise Site Key) ---
APPCHECK_RECAPTCHA_KEY=your_recaptcha_site_key_here

# --- Server-side / Admin SDK Configuration (Secret Manager / Cloud Functions) ---
# In Google Cloud Functions, applicationDefault() uses IAM service accounts automatically.
# For local server tools, point to your securely stored service account file outside the repo:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/secure/serviceAccountKey.json

# --- Designated Platform Administrators ---
