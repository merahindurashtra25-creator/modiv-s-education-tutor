{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(self \"https://checkout.razorpay.com\"), usb=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebasestorage.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com wss://*.firebaseio.com https://maps.googleapis.com https://api.razorpay.com https://lumberjack.razorpay.com https://*.razorpay.com https://*.firebaseapp.com https://accounts.google.com https://*.google.com https://apis.google.com; img-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.gstatic.com https://maps.googleapis.com https://*.firebaseapp.com https://checkout.razorpay.com https://*.razorpay.com https://apis.google.com https://accounts.google.com https://*.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https: blob: data: https://api.razorpay.com https://checkout.razorpay.com https://*.firebaseapp.com https://accounts.google.com https://*.google.com;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/modivs-admin.html" },
    { "source": "/login", "destination": "/modivs-education.html" },
    { "source": "/tutor-dashboard", "destination": "/modivs-tutor-dashboard.html" },
    { "source": "/student-dashboard", "destination": "/modivs-student-dashboard.html" },
    { "source": "/tutor-profile", "destination": "/modivs-tutor-profile.html" },
    { "source": "/tutor-edit-profile", "destination": "/modivs-tutor-edit-profile.html" },
    { "source": "/student-registration", "destination": "/modivs-student-registration.html" },
    { "source": "/tutors", "destination": "/modivs-tutors.html" },
    { "source": "/find-a-tutor", "destination": "/modivs-find-tutor.html" },
    { "source": "/find-a-modivian-tutor", "destination": "/modivs-find-tutor.html" },
    { "source": "/become-a-modivian-tutor", "destination": "/modivs-become-tutor.html" },
    { "source": "/active-leads", "destination": "/modivs-active-leads.html" },
    { "source": "/shop", "destination": "/modivs-shop.html" },
    { "source": "/blogs", "destination": "/modivs-blogs.html" },
    { "source": "/students-corner", "destination": "/modivs-students-corner.html" },
    { "source": "/contact", "destination": "/modivs-contact.html" },
    { "source": "/privacy-policy", "destination": "/modivs-privacy-policy.html" },
    { "source": "/terms", "destination": "/modivs-terms.html" },
    { "source": "/refund-policy", "destination": "/modivs-refund-policy.html" },
    { "source": "/sitemap", "destination": "/modivs-sitemap.html" }
  ]
}
